{
  "manifest_version": 3,
  "name": "大懒虫",
  "version": "1.5.1",
  "description": "抖音、快手及网页视频解析与下载，支持批量解析、多线程下载与 HLS。",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "webRequest",
    "downloads",
    "storage",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "大懒虫",
    "default_icon": {
      "16": "assets/icon-16.png",
      "24": "assets/icon-24.png",
      "32": "assets/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.douyin.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://*.kuaishou.com/*",
        "https://kuaishou.com/*",
        "https://*.kuaishou.cn/*",
        "https://kuaishou.cn/*",
        "https://*.chenzhongtech.com/*",
        "https://*.chenzhongtech.cn/*"
      ],
      "js": [
        "kuaishou.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "options_page": "manager.html#settings"
}
